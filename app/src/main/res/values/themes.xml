<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 横屏工控平板主题：无系统 ActionBar（等价 Delphi 窗体自带标题栏的简化） -->
    <style name="Theme.Emrs" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/panel_gray</item>
        <item name="colorPrimary">#3F51B5</item>
        <item name="colorPrimaryDark">#303F9F</item>
        <item name="colorAccent">@color/emrs_red</item>
    </style>

    <style name="EmrsButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="EmrsLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="EmrsEdit">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:background">@drawable/bg_edit</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
    </style>

    <!-- 设置屏行容器（Form3 两列布局） -->
    <style name="SetupRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <!-- 设置屏红色标签 -->
    <style name="SetupLabel">
        <item name="android:layout_width">110dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/emrs_red</item>
    </style>

    <!-- 设置屏输入框（固定比例宽） -->
    <style name="SetupEdit">
        <item name="android:layout_width">180dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:background">@drawable/bg_edit</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
    </style>

    <!-- 设置屏下拉框 -->
    <style name="SetupSpin">
        <item name="android:layout_width">180dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">8dp</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- 自检屏（Form2）：GroupBox“自检结果”：电池电压 + VAB 电压条 + 返回 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/panel_gray"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_panel_white"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/selftest_group"
            android:textSize="22sp"
            android:textColor="@color/emrs_blue"
            android:textStyle="bold" />

        <!-- 电池电压（Edit2） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_voltage"
                android:textSize="19sp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tv_battery"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:gravity="center"
                android:background="@drawable/bg_edit"
                android:padding="6dp"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:text="54" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/unit_v"
                android:textSize="19sp"
                android:textColor="@color/black" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@color/panel_gray" />

        <!-- VAB（Edit1 + TrackBar1 只读显示） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VAB"
                android:textSize="19sp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tv_vab"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:gravity="center"
                android:background="@drawable/bg_edit"
                android:padding="6dp"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:text="50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/unit_v"
                android:textSize="19sp"
                android:textColor="@color/black" />
        </LinearLayout>

        <com.qiangyuan.emrs.ui.common.VBarMeter
            android:id="@+id/vbar_vab"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="24dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_return"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginTop="8dp"
        android:minHeight="@dimen/min_button_h"
        android:background="@drawable/bg_button"
        android:textSize="18sp"
        android:text="@string/btn_return" />

</LinearLayout>

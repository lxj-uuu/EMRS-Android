        android:pathData="M12,66 C24,66 26,38 38,38 C50,38 52,74 64,74 C76,74 78,30 90,30"
        android:strokeColor="#00CC66"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 红色基线 -->
    <path
        android:pathData="M12,88 L96,88"
        android:strokeColor="#E60000"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

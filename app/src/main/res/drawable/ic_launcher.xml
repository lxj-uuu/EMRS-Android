    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 深蓝圆角底 -->
    <path
        android:fillColor="#1A3C6E"
        android:pathData="M12,4 L96,4 A8,8 0 0 1 104,12 L104,96 A8,8 0 0 1 96,104 L12,104 A8,8 0 0 1 4,96 L4,12 A8,8 0 0 1 12,4 Z" />

